{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "slowbit-board",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-10-06",
  "workers_dev": true,
  "vars": {
    "BOARD_ALLOWED_ORIGINS": "https://slowbit.vercel.app"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "slowbit-board",
      "database_id": "c2e7e9c9-89c4-4267-914a-3e225e7729df",
      "migrations_dir": "./drizzle"
    }
  ]
}
